{
  "name": "sslbear-cli",
  "version": "0.2.0",
  "description": "证书熊 CLI：查询并部署 / 更新阿里云、腾讯云、火山引擎、华为云、百度智能云、七牛云云服务上的域名 SSL 证书",
  "type": "module",
  "bin": {
    "sslbear-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs/permissions.md",
    "docs/limitations.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "ssl",
    "certificate",
    "aliyun",
    "tencentcloud",
    "volcengine",
    "huaweicloud",
    "baiducloud",
    "qiniu",
    "cdn",
    "sslbear"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Qsnh/sslbear-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qsnh/sslbear-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Qsnh/sslbear-cli/issues"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "commander": "^12.1.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
