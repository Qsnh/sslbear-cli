{
  "name": "sslbear-cli",
  "version": "0.1.0",
  "description": "证书熊 CLI：查询阿里云、腾讯云云服务上的域名及其 SSL 证书",
  "type": "module",
  "bin": {
    "sslbear-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "ssl",
    "certificate",
    "aliyun",
    "tencentcloud",
    "cdn",
    "sslbear"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "commander": "^12.1.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
